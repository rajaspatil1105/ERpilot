    },
    {
      "rule_id": "AT-02",
      "category": "abdominal_trauma",
      "conditions": [
        "abdominal_trauma_suspected_haemorrhage_with_unstable_nonresponsive_context"
      ],
      "conclusion": "abdominal_trauma_limited_imaging_context_requires_review",
      "priority_flag": "ORANGE",
      "suggested_department": "Emergency Department",
      "checklist_action": "Flag the documented haemorrhage context for clinician review of the minimum imaging needed to direct intervention; do not order or limit imaging autonomously.",
